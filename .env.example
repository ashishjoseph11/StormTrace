# ==============================================================================
# ZATICS v3.0 // CYCLONE IMPACT FORECASTER — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your keys:
#   cp .env.example .env
# ==============================================================================

# 1. Google Gemini AI API Key (Required for AI Advisories, Executive Briefings, Multilingual Copilot)
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Earth Engine (GEE) Service Account (Optional / Enterprise)
# Set your GEE Service Account and Project ID if using live GEE Satellite SAR telemetry
GEE_SERVICE_ACCOUNT=your_service_account@your-gcp-project.iam.gserviceaccount.com
GEE_PROJECT_ID=your-gcp-project-id
GEE_PRIVATE_KEY_PATH=api/gee-credentials.json

# 3. Optional Geospatial & SMS Gateways
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=
SMS_GATEWAY_API_KEY=

# 4. Server Configuration
PORT=8000
